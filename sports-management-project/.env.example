# =============================================================================
# CONFIGURACIÓN DE BASES DE DATOS - VARIABLES DE ENTORNO
# =============================================================================
# Copia este archivo a .env y completa con tus credenciales reales.
# NO subas este archivo al repositorio - ya está en .gitignore
# =============================================================================

# ----- PostgreSQL (Neon) -----
# Obtén tu connection string desde el dashboard de Neon:
# https://console.neon.tech/app/projects
# Ejemplo: jdbc:postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/sports_db?sslmode=require
POSTGRES_JDBC_URL=jdbc:postgresql://your-neon-connection-string
POSTGRES_USERNAME=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password

# ----- MongoDB Atlas -----
# Obtén tu connection string desde el dashboard de MongoDB Atlas:
# https://www.mongodb.com/cloud/atlas
# Ejemplo: mongodb+srv://cluster0.xxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your-mongodb-atlas-connection-string
MONGODB_DATABASE=sports_metrics

# ----- Configuración Opcional -----
SERVER_PORT=8080